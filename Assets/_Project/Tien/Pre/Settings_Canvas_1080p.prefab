  m_text: "\n<size=28><color=#FFD700><b>\u2756 \u0110\u1ED2 \xC1N T\u1ED0T NGHI\u1EC6P
    \u2756</b></color></size>\n<size=20><color=#FFFFFF><b>CHUY\xCAN NG\xC0NH PH\xC1T
    TRI\u1EC2N GAME & \u0110\u1ED2 H\u1ECCA</b></color></size>\n\n<color=#6A538A>\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</color>\n\n<size=22><color=#FFCC00><b>GI\u1EA2NG
    VI\xCAN H\u01AF\u1EDANG D\u1EAAN</b></color></size>\n<size=19><color=#FFFFFF>ThS.
    Gi\u1EA3ng Vi\xEAn Ph\u1EE5 Tr\xE1ch</color></size>\n\n<color=#6A538A>\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</color>\n\n<size=22><color=#FFCC00><b>\u0110\u1ED8I
    NG\u0168 PH\xC1T TRI\u1EC2N</b></color></size>\n\n<b>Nguy\u1EC5n Ti\u1EBFn</b>
    \u2014 <color=#66DDFF>Project Lead</color>\n<b>Nguy\u1EC5n Duy</b> \u2014 <color=#66DDFF>Gameplay
    & Audio</color>\n<b>V\u0169 H\u1EA3i</b> \u2014 <color=#66DDFF>UI/UX & Menu</color>\n<b>Qu\u1ED1c</b>
    \u2014 <color=#66DDFF>Level Design</color>\n<b>B\u1EA3o</b> \u2014 <color=#66DDFF>Boss
    & Minigame</color>\n\n<color=#6A538A>\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</color>\n\n<size=22><color=#FFCC00><b>T\xC0I
    NGUY\xCAN & C\xD4NG NGH\u1EC6</b></color></size>\n\nLayer Lab \u2014 <color=#99E6FF>GUI
    Pro-FantasyRPG</color>\nUnity Technologies \u2014 <color=#99E6FF>Unity Engine
    2022/2023</color>\n\n<color=#6A538A>\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</color>\n\n<size=19><color=#FFDD88><i>C\u1EA3m
    \u01A1n c\xE1c b\u1EA1n \u0111\xE3 tr\u1EA3i nghi\u1EC7m tr\xF2 ch\u01A1i!</i></color></size>\n"
  m_isRightToLeft: 0
